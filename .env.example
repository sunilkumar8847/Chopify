# Chopify configuration template. Copy to .env (same folder) and fill in.
# .env is ignored by Git: never commit real keys. Restart Studio after editing.
# A Windows environment variable with the same name wins over .env.

# Chopify AI Provider API Keys (leave empty if you do not use a provider)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Optional YouTube public Data API key
CHOPIFY_YOUTUBE_API_KEY=

# AI execution defaults (these are also ceilings: Studio can be stricter, never looser)
CHOPIFY_AI_FREE_ONLY=true
CHOPIFY_AI_ALLOW_PAID=false
CHOPIFY_AI_DAILY_BUDGET_USD=0
CHOPIFY_AI_MONTHLY_BUDGET_USD=0
CHOPIFY_AI_LOCAL_FALLBACK=false

# Groq account configuration: free | developer
CHOPIFY_GROQ_PLAN=free
