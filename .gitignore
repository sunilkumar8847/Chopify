upload_usage.json
upload_settings.json
uploads.json
publish_consents.json
ai_settings.json
features.json
scheduler.json
discovery.json
ai_slots/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.claude/settings.local.json

