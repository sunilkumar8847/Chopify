# ---------------------------------------------------------------------------
# Secrets, credentials and local environment - never commit
# (Chopify keeps OAuth tokens and its own settings encrypted or in
#  %APPDATA%\Chopify / $CHOPIFY_CONFIG, outside the repository.)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env.local
ai_keys.bin
youtube_*.bin
*.bin.*.tmp
client_secret*.json
credentials*.json
service-account*.json
*token*.json
*.pem
*.key
*.p12
*.pfx
# Chopify settings/state, if a config folder is ever pointed at the repo root
/upload_usage.json
/upload_settings.json
/uploads.json
/publish_consents.json
/ai_settings.json
/features.json
/scheduler.json
/discovery.json
/ai_slots/
/*.db
/*.db-wal
/*.db-shm
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Python environments and caches
# ---------------------------------------------------------------------------
.venv/
venv/
/env/
/ENV/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------------------------------------------------------------------------
# Chopify output folders: projects (recordings, transcripts, clips, previews,
# live buffers, scheduler databases), rendered clips, work files, logs
# ---------------------------------------------------------------------------
/projects/
/clips/
/previews/
/work/
/logs/
/_site/
/_bench/
/_phase*/
# media, subtitles and logs written next to the repo root by CLI runs
# (anywhere else - tests/fixtures, assets, docs - stays trackable)
/*.mp4
/*.mkv
/*.webm
/*.mov
/*.m4a
/*.mp3
/*.wav
/*.flac
/*.srt
/*.ass
/*.jsonl
*.log
# downloads and temporary files (never source)
*.part
*.part-Frag*
*.ytdl
*.tmp
*.temp
download-*/
.ai-pieces-*/
_partial-*

# ---------------------------------------------------------------------------
# AI models and large local-only builds
# ---------------------------------------------------------------------------
/models/
*.onnx
*.gguf
*.safetensors
*.ckpt
/whisper.cpp/
/whisper_old/
/build_msvc*/

# ---------------------------------------------------------------------------
# Local helper scripts at the repo root; the installer is part of the project
# (scripts in subfolders such as tools/ stay trackable)
# ---------------------------------------------------------------------------
/*.sh
!/install.sh

# ---------------------------------------------------------------------------
# Local agent state, editors and operating-system files
# ---------------------------------------------------------------------------
.mimosa/
.zcode/
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
